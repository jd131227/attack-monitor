# monitor.conf - configuration file (KEY=VALUE format)
# Copy this to monitor.conf and edit it for your environment.

# Loop interval (seconds)
INTERVAL=10

# Time window for threshold evaluation (how many recent seconds are aggregated)
WINDOW=300

# SSH failures allowed within the window (alert at or above this)
SSH_FAIL_THRESHOLD=20

# Simultaneous connections allowed from one source IP (spec 3.2)
CONN_THRESHOLD=50

# Alert-exclusion IPs (space- or comma-separated). Allow-list IPs are also
# excluded automatically.
WHITELIST_IPS=

# Ports that are expected to be open; any other LISTEN port triggers an alert (3.3)
EXPECTED_PORTS=22 80 443

# Ports treated as "SSH" for access control (apply-firewall locks these down)
ALLOWED_SSH_PORTS=22

# Process names excluded from the high-usage detector (3.4)
PROC_WHITELIST=
# %CPU / %MEM at or above which a process is flagged
PROC_CPU_THRESHOLD=90
PROC_MEM_THRESHOLD=90

# Monitor output log / audit log / persisted allow-IP list
LOG_FILE=/var/log/attack-monitor.log
AUDIT_LOG_FILE=/var/log/attack-monitor-audit.log
ALLOWED_IPS_FILE=/etc/attack-monitor/allowed_ips.conf

# Auth log to parse. auto picks /var/log/auth.log (Debian) or /var/log/secure (RHEL)
AUTH_LOG=auto

# Firewall backend: auto / ufw / firewalld / nft
FW_BACKEND=auto
# firewalld zone to manage (firewalld backend only)
FW_ZONE=public
# Where firewall-state backups and the "currently enforcing" marker live
FW_BACKUP_DIR=/var/lib/attack-monitor/backups
FW_STATE_FILE=/var/lib/attack-monitor/enforced.json
# Re-apply the firewall automatically when a temporary allow (TTL) expires.
# Leave false unless you understand the lockout implications.
FW_AUTO_SYNC=false

# Enable/disable individual monitors
ENABLE_IPV6=true
ENABLE_CONN_MON=true
ENABLE_PORT_MON=true
ENABLE_PROC_MON=true

# Rotate LOG_FILE once it grows past this many bytes (spec 5.2)
LOG_MAX_BYTES=10485760

# Optional external notify command (spec 5.3). The alert event is sent as JSON
# on stdin. Leave empty for stdout + log only.
NOTIFY_CMD=
